# --- Application -----------------------------------------------------------
# URL publique de l'application, sans barre finale.
# En local pour tester sur un téléphone du même Wi-Fi : http://192.168.x.x:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mode dev uniquement : IP de l'ordinateur pour ouvrir l'app depuis un téléphone du même Wi-Fi.
ALLOWED_DEV_ORIGINS=

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : uniquement côté serveur. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails transactionnels -------------------------------------------------
# "console" : les e-mails sont écrits dans les logs du serveur et marqués
#             "simulé" dans l'historique (aucun envoi réel).
# "resend"  : envoi réel via https://resend.com (clé ci-dessous requise).
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Adresse d'expédition vérifiée chez le fournisseur.
EMAIL_FROM="Atelier Sucré <notifications@votre-domaine.fr>"

# --- Anti-abus ---------------------------------------------------------------
# Sel aléatoire pour hacher les adresses IP (openssl rand -hex 32).
RATE_LIMIT_SALT=

# --- Paiements (Stripe en MODE TEST pendant le pilote) ------------------------
# Sans STRIPE_SECRET_KEY, les paiements sont SIMULÉS (page « Paiement simulé »),
# automatiquement en développement, ou en production si PAIEMENTS_SIMULES=1.
# Une clé sk_live_ est refusée par l'application.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix récurrents mensuels créés dans Stripe (mode test) pour les abonnements :
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
PAIEMENTS_SIMULES=

# --- Tâches planifiées (rappels, libération des réservations expirées) -------
# Secret partagé avec le planificateur (Vercel Cron l'envoie automatiquement).
CRON_SECRET=
